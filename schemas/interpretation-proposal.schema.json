{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emotion Engine Interpretation Proposal",
  "description": "A bounded model proposal. Inferences remain hypotheses and require deterministic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_summary", "summary_evidence_refs", "appraisal", "meaning_hypotheses", "emotion_hypotheses", "alternative_explanations", "unknowns", "clarifying_questions"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "event_summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "summary_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
    "appraisal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relevance": {"$ref": "#/$defs/appraisalNote01"},
        "expectedness": {"$ref": "#/$defs/appraisalNote01"},
        "goal_congruence": {"$ref": "#/$defs/appraisalNote11"},
        "coping_potential": {"$ref": "#/$defs/appraisalNote01"},
        "normative_significance": {"$ref": "#/$defs/appraisalNote01"}
      }
    },
    "meaning_hypotheses": {"$ref": "#/$defs/textHypotheses"},
    "emotion_hypotheses": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "rationale", "evidence_refs"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "alternative_explanations": {"$ref": "#/$defs/textHypotheses"},
    "unknowns": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "clarifying_questions": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "$defs": {
    "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "appraisalNote01": {
      "type": "object", "additionalProperties": false, "required": ["value", "rationale", "evidence_refs"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "appraisalNote11": {
      "type": "object", "additionalProperties": false, "required": ["value", "rationale", "evidence_refs"],
      "properties": {
        "value": {"type": "number", "minimum": -1, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "textHypotheses": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["statement", "evidence_refs"],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "maxLength": 1200},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    }
  }
}
